#
# How To Use
#

# 1. USB #1: flash the Ubuntu Server 26.04 LTS ISO.
# 2. USB #2: FAT32, volume label exactly  CIDATA , containing:
#      - this file, RENAMED to:  user-data   (no extension)
#      - an empty file named:    meta-data
# 3. Boot the installer with wired network (the Server installer has no
#    Wi-Fi; reis-bootstrap.sh configures Wi-Fi after first boot).
# 4. The installer detects the seed, asks ONE confirmation, and runs
#    unattended - including storage. Read the warning below first.


#
# Risks & Mitigation
#

# Deleted Partitions

# early-commands below DELETE partitions 5 and 6 on /dev/nvme0n1 (the
# existing Ubuntu /boot and encrypted /, which this install replaces).
# Partitions 1-4 (EFI, MSR, Windows C:, Recovery) are preserved with
# exact byte sizes from the sector table below - if reality disagrees with
# any size, curtin ABORTS instead of touching the disk. That verification
# is the Windows tripwire; do not "fix" a size mismatch by editing the YAML
# until you understand why it mismatched.

# Back Up The Partition Table First

# From the existing Ubuntu install (or the
# installer's shell), before booting with the CIDATA seed:
#     sudo sgdisk --backup=reis-gpt.bak /dev/nvme0n1
#     # then copy reis-gpt.bak somewhere OFF this disk (another machine
#     # or a separate stick - not the seed stick)
# restore later, from any live environment, if it's ever needed:
#     sudo sgdisk --load-backup=reis-gpt.bak /dev/nvme0n1
# this saves the protective MBR and both GPT copies - partition boundaries
# only, not partition contents.


#
# Fill In Before Use
#

# search CHANGEME - there are four:
#   identity.username   the login to create (defaults to reis).
#   identity.password   SHA-512 crypt hash:  openssl passwd -6
#                       (OpenSSL >= 1.1.1; LibreSSL builds lack -6)
#                       or  mkpasswd -m sha-512
#   ssh.authorized-keys the public key you'll SSH in with (SSH is key-only
#                       from boot; console login uses the password above)
#   dm_crypt key        the LUKS passphrase. It sits in PLAINTEXT in this
#                       file, is typed at the PHYSICAL console every boot
#                       (headless trade-off: remote unlock needs
#                       dropbear-initramfs; TPM auto-unlock needs clevis -
#                       both optional, later), and is persisted by the
#                       installer into /var/log/installer and /var/lib/cloud
#                       until the bootstrap script wipes those copies.
#
# secrets strategy: treat the password and the LUKS passphrase in this file
# as install-time throwaways - hard to guess, never reused, and assumed
# burned the moment they touch the seed stick. Rotate both ON DEVICE at
# first login; the bootstrap's closing summary is the playbook. The SSH key
# is the one credential here that's safe to keep: it is public by design.


#
# Partition Table Of Record
#

# NVMe CA6-8D1024, 512 B sectors:
#   p1  EFI         100 MiB     sectors 2048-206847             -> reused for GRUB
#   p2  MSR         16 MiB      sectors 206848-239615           -> preserved
#   p3  Windows     451559 MiB  sectors 239616-925032447        -> preserved
#   --  unallocated 1 MiB       sectors 925032448-925034495     -> left alone
#   p4  Recovery    797 MiB     sectors 925034496-926666751     -> preserved
#   p5  /boot       1 GiB       sectors 926666752-928763903     -> replaced in place
#         new p5: /boot, ext4, 1 GiB  - GPT name: reis-boot
#   p6  /, LUKS     255 GiB     sectors 928763904-1463537663    -> replaced in place
#         new p6: LUKS (dm_name: reis) [/, btrfs, 255 GiB  - GPT name: reis]
#   --  scratch     256 GiB     sectors 1463537664-2000408575   -> left alone
#         Deliberately left unallocated by this installer. reis-bootstrap.sh
#         creates a ZFS partition + pool here only if one doesn't already exist; it
#         is meant to survive OS reinstalls (this file never touches p7).
#         GPT name: tank (set by the bootstrap; the pool is opened via
#         /dev/disk/by-partlabel/tank)
#   --  tail        344 KiB     sectors 2000408576-2000409263   -> left alone
#         Alignment slack; the disk's secondary GPT occupies its final 33 sectors.


autoinstall:
  version: 1

  locale: en_US.UTF-8
  keyboard:
    layout: us

  source:
    id: ubuntu-server
    search_drivers: true

  drivers:
    install: true

  identity:
    hostname: reis
    username: reis                          # CHANGEME: the login to create
    password: "CHANGEME-SHA512-CRYPT"       # CHANGEME: install-time throwaway; rotate on device

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "CHANGEME ssh-ed25519 AAAA... user@host"   # CHANGEME: your SSH public key

  timezone: America/Chicago

  updates: security

  # Ordered: hardware enablement, then reis-bootstrap.sh dependencies, then
  # wants - alphabetical within each. Everything the bootstrap depends on is
  # satisfied here; anything beyond this list arrives via Homebrew.
  packages:
    - ubuntu-drivers-common
    - wpasupplicant
    - btrfs-progs
    - curl
    - gdisk
    - parted
    - zfsutils-linux
    - build-essential
    - fish
    - git
    - git-lfs

  # Clears the existing Ubuntu install (p5 /boot, p6 encrypted /) so the
  # storage config below can recreate them in place. See warning at top.
  early-commands:
    - parted --script /dev/nvme0n1 rm 6 || true
    - parted --script /dev/nvme0n1 rm 5 || true

  storage:
    swap:
      size: 0                # no swapfile (btrfs root; hibernation is masked anyway)
    config:

      - type: disk
        id: nvme0
        path: /dev/nvme0n1   # single-NVMe Blade; adjust only if enumeration differs
        ptable: gpt
        preserve: true

      # preserved partitions (sizes are the tripwire - see warning)
      - type: partition
        id: p1-efi
        device: nvme0
        number: 1
        size: 104857600          # 100 MiB
        flag: boot
        grub_device: true        # GRUB installs into the existing ESP
        preserve: true
      - type: partition
        id: p2-msr
        device: nvme0
        number: 2
        size: 16777216           # 16 MiB
        preserve: true
      - type: partition
        id: p3-windows
        device: nvme0
        number: 3
        size: 473493929984       # 451,559 MiB
        preserve: true
      - type: partition
        id: p4-recovery
        device: nvme0
        number: 4
        size: 835715072          # 797 MiB
        preserve: true

      # replacements, byte-exact so the ZFS scratch block stays free
      - type: partition
        id: p5-boot
        device: nvme0
        number: 5
        size: 1073741824         # 1 GiB
        partition_name: reis-boot
        wipe: superblock
        preserve: false
      - type: partition
        id: p6-crypt
        device: nvme0
        number: 6
        size: 273804165120       # 255 GiB
        partition_name: reis
        wipe: superblock
        preserve: false

      - type: dm_crypt
        id: luks0
        volume: p6-crypt
        dm_name: reis
        key: "CHANGEME-LUKS-PASSPHRASE"     # CHANGEME: install-time throwaway; rotate on device
        preserve: false

      # filesystems & mounts
      - type: format
        id: fs-efi
        volume: p1-efi
        fstype: fat32
        preserve: true           # reuse, do not reformat, the shared ESP
      - type: format
        id: fs-boot
        volume: p5-boot
        fstype: ext4
        preserve: false
      - type: format
        id: fs-root
        volume: luks0
        fstype: btrfs
        preserve: false

      - type: mount
        id: m-root
        device: fs-root
        path: /
      - type: mount
        id: m-boot
        device: fs-boot
        path: /boot
      - type: mount
        id: m-efi
        device: fs-efi
        path: /boot/efi

  # Headless-laptop hardening from the very first boot.
  late-commands:
    - 'mkdir -p /target/etc/systemd/logind.conf.d'
    - 'printf "[Login]\nHandleLidSwitch=ignore\nHandleLidSwitchExternalPower=ignore\nHandleLidSwitchDocked=ignore\n" > /target/etc/systemd/logind.conf.d/99-headless-lid.conf'
    - 'curtin in-target --target=/target -- systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target'

  shutdown: reboot
